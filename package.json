{
  "name": "mock-startup-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "blog:images": "node scripts/sync-blog-social-images.cjs",
    "dev": "npm run blog:images && next dev --webpack",
    "build": "npm run blog:images && next build --webpack && node scripts/validate-static-redirects.cjs",
    "images:optimize": "node scripts/optimize-images.cjs",
    "start": "next start",
    "lint": "eslint .",
    "test:playwright": "npm run blog:images && playwright test",
    "test:screenshots": "npm run blog:images && playwright test --headed"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.3.2",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-highlight": "^7.0.2",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "simple-icons": "^16.33.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^16.4.3",
    "fast-glob": "file:scripts/next-lint-glob",
    "sharp": "^0.35.5",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "@next/eslint-plugin-next": {
      "fast-glob": "$fast-glob"
    },
    "gray-matter": {
      "js-yaml": "$js-yaml"
    },
    "postcss": "8.5.25",
    "sharp": "$sharp"
  },
  "allowScripts": {
    "fsevents@2.3.2": true,
    "sharp@0.35.5": true,
    "unrs-resolver@1.12.2": true
  }
}
